# Copy this file to .env and fill in your values:
#   copy .env.example .env

# Chrome DevTools Protocol (remote debugging)
CDP_HOST=127.0.0.1
CDP_PORT=9222

# Dedicated Chrome profile (relative to repo root, or absolute path)
CHROME_USER_DATA_DIR=./chrome-profile

# Required: Gemini API key
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: replace Gemini CLI system prompt with a file
# SYSTEM_PROMPT_FILE=
