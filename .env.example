# Copy this file to .env and fill in your values:
#   copy .env.example .env

# Chrome DevTools Protocol (remote debugging)
CDP_HOST=127.0.0.1
CDP_PORT=9222

# Dedicated Chrome profile (relative to repo root, or absolute path)
CHROME_USER_DATA_DIR=./chrome-profile

# Required: Google AI / Gemini API key
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here

# Optional: default Gemini model (overridden by --model)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Chrome download folder for Gemini output (relative to repo root)
DOWNLOAD_DIR=./downloads

# Optional: replace Gemini CLI system prompt with a file
# SYSTEM_PROMPT_FILE=
